# Copy to `.env` and adjust for your environment.
# All values are read by app/core/config.py (pydantic-settings).

# Ollama - local LLM server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=mxbai-embed-large
# Timeout (seconds) for LLM generation calls
LLM_TIMEOUT=60

# Qdrant - vector database for RAG
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=Copilot-collection

# MCP - Model Context Protocol
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
# "sse" talks to the FastMCP server over the real MCP protocol (Linux/Docker);
# "inprocess" runs the tools locally (offline development / Windows / tests)
MCP_TRANSPORT=inprocess
# metadata backend for MCP tools: "inmemory" (demo catalog) | "trino" (live information_schema)
MCP_METADATA_SOURCE=inmemory

# Trino - SQL query engine
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=tpch
TRINO_SCHEMA=tiny

# API Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# RAG Configuration
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.6

# SQL Agent
MAX_REGENERATION_ATTEMPTS=3

# Query execution (best-effort; MCP execute_sql against Trino)
ENABLE_SQL_EXECUTION=true